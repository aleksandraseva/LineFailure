{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/LineFailure/manage.py",
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Django: Management Command",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/LineFailure/manage.py",
            "args": [
                "FillDatabase"
            ],
            "django": true,
            "justMyCode": true
        }
    ]
}